POSTGRES_DB=onetake
POSTGRES_USER=onetake
POSTGRES_PASSWORD=onetake_dev_password
DATABASE_URL=postgresql+psycopg://onetake:onetake_dev_password@postgres:5432/onetake

REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ROOT_USER=onetake
MINIO_ROOT_PASSWORD=onetake_dev_password
MINIO_BUCKET=onetake-media
MINIO_SECURE=false
MINIO_REGION=us-east-1

DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,postgres,redis,minio,api,web,dashscope.aliyuncs.com,imageseg.cn-shanghai.aliyuncs.com,aliyuncs.com

MOCK_PROVIDERS=true
RECOGNITION_PROVIDER=mock
IMAGE_EDIT_PROVIDER=mock
QWEN_IMAGE_EDIT_PRICE_PER_CALL=
MATTING_PROVIDER=mock
SCRIPT_PROVIDER=mock
VOICE_PROVIDER=mock
VOICE_MODEL=cosyvoice-v2
COMPOSITION_PROVIDER=mock
CREATIVE_PLANNER_PROVIDER=rules
CREATIVE_PLANNER_MODEL=qwen-plus
CREATIVE_PLANNER_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
CONTENT_QA_PROVIDER=rules
CONTENT_QA_MODEL=qwen3-vl-plus
CONTENT_QA_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
CONTENT_QA_FRAME_COUNT=5
WAN_I2V_PROVIDER=mock
# 数字人档位已下线（2026-10-14，档案 M4-04）：本开关无消费者，保留仅为兼容既有部署
AVATAR_VIDEO_PROVIDER=mock
WAN_S2V_MODEL=
WAN_S2V_RESOLUTION=720P
WAN_S2V_MAX_SECONDS=30
WAN_S2V_PRICE_PER_SECOND=
WAN_S2V_AVATAR_PATH=
WAN_I2V_MODEL=
WAN_I2V_RESOLUTION=720P
WAN_I2V_WITH_AUDIO=false
WAN_I2V_MAX_SECONDS=5
WAN_I2V_PRICE_PER_SECOND=0.15
VIDEO_ESTIMATE_CONFIRMATION_THRESHOLD=5
VIDEO_ESTIMATE_MINUTES_PER_CLIP=1
VIDEO_ESTIMATE_OVERHEAD_MINUTES=0.5
VIDEO_CONTINUITY_ENABLED=true
VIDEO_TAIL_OFFSET_FRAMES=2
VIDEO_MAX_CANDIDATES_PER_SEGMENT=8
RECOGNITION_MODEL=qwen3-vl-plus
RECOGNITION_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
MOCK_RECOGNITION_MODE=success
DASHSCOPE_API_KEY=
IMAGE_EDIT_MODEL=qwen-image-edit-plus
IMAGE_EDIT_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
SCRIPT_MODEL=qwen3-vl-plus
SCRIPT_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
PHOTOROOM_API_KEY=
PHOTOROOM_ENDPOINT=https://sdk.photoroom.com/v1/segment

ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION_ID=cn-shanghai
ALIYUN_IMAGESEG_ENDPOINT=imageseg.cn-shanghai.aliyuncs.com
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
SHOTSTACK_API_BASE=https://api.shotstack.io
SHOTSTACK_POLL_INTERVAL_SECONDS=2
SHOTSTACK_POLL_TIMEOUT_SECONDS=600
SHOTSTACK_MAX_RETRIES=3
SHOTSTACK_RETRY_BACKOFF_SECONDS=2
SHOTSTACK_RENDER_PRICE=
PROJECT_TTL_HOURS=24
MEDIA_CLEANUP_INTERVAL_SECONDS=3600

ONETAKE_MCP_TOKEN=change-me
ONETAKE_MCP_REQUEST_TIMEOUT_SECONDS=10
ONETAKE_MCP_WRITE_ENABLED=false
ONETAKE_MCP_PAID_ENABLED=false
ONETAKE_MCP_APPROVAL_TOKEN=
ONETAKE_MCP_ASSET_HOSTS=

# ---- 商品入画链路（Phase 0-4 新增；默认值即目标状态，可逐项回退）----
# 生成路径默认值：segmented（分段，可控）| one_shot（整片一次生成）
GENERATION_PATH_DEFAULT=segmented
# 关键帧：integrated（商品入画，默认）| erase_background（旧空背景路径）
KEYFRAME_MODE=integrated
KEYFRAME_CANDIDATES=2
KEYFRAME_PIXEL_LOCK_FALLBACK=true
KEYFRAME_QA_PROVIDER=rules
KEYFRAME_IMAGE_SIZE=1080*1920
# i2v 运动提示词引擎（Phase 2）
VIDEO_MOTION_PROMPT_ENABLED=true
# 首尾帧转场（Phase 2）：需要 WAN_KF2V_MODEL 才生效
VIDEO_KF2V_ENABLED=true
# 整片一次生成路径是否保留模型原声（口型台词）；开启时不再叠 TTS，避免双声。默认 false：语音只来自 TTS
VIDEO_KEEP_MODEL_AUDIO=false
WAN_KF2V_MODEL=wan2.2-kf2v-flash
# 整片一次生成（Phase 3）
WAN_R2V_MODEL=
WAN_R2V_RESOLUTION=720P
WAN_R2V_MAX_SECONDS=15

# 超时预算（2026-10-15 修：video 作业原本硬编码 600 秒 → one_shot 必超）
# one_shot 的全部 r2v 调用都在同一个 video 作业里；实测单次 10s 片段就要 438 秒，
# 18s 脚本切 2 次调用 → 600 秒必然被 rq 掐掉（钱已花、片子没出来）。
# video_job_timeout_seconds 必须 > 调用次数 × wan_r2v_poll_timeout_seconds + 拼接/合成余量。
VIDEO_JOB_TIMEOUT_SECONDS=2400
WAN_R2V_POLL_TIMEOUT_SECONDS=900
# 本地合成与后处理（Phase 4）
NATIVE_FEEL_ENABLED=true
NATIVE_FEEL_STRENGTH=subtle
# AIGC 标识（本地叠加优先，必须在最后一步烧录）
AIGC_LABEL_ENABLED=true
AIGC_LABEL_TEXT=AI生成
AIGC_LABEL_POSITION=top_right
AIGC_LABEL_SIZE_RATIO=0.028
AIGC_LABEL_OPACITY=0.75
AIGC_LABEL_SAFE_MARGIN_RATIO=0.04
AIGC_LABEL_AVOID_SUBTITLE=true
AIGC_LABEL_SOURCE=local
# 交付门（Phase 5）
GATE_MODE=enforce

# ---- 自动链（S8+S9+S10）----
# 自动链默认关闭；要一键跑「识别 → 主图 → 文案 → 配音字幕」必须显式打开
AUTO_RUN_ENABLED=false
# 自动链预算（元）。0 = 只跑免费 / mock 阶段；付费阶段一律停下等人审批
AUTO_RUN_BUDGET_CNY=0
# 自动链配音音色：默认与活前端配音面板一致（longxiaochun_v2 / longwan_v2 / longcheng_v2 三选一）
# 换音色就改这一行；mock 适配器忽略该值（免费链路不受影响）
AUTO_RUN_VOICE_ID=longxiaochun_v2

# ---- 字幕样式（批次 1a）----
# 四档：standard（默认）/ bold / minimal / karaoke；字号按帧宽比例，默认档与改造前逐字相同
CAPTION_STYLE=standard

# ---- BGM（批次 4b：0 成本路径）----
# 默认关闭 → 不叠 BGM 时成片逐字节不变；开启后旁白会把音乐压下去（sidechain 闪避）
BGM_ENABLED=false
# 音乐相对电平（dB，负值）；旁白段实测不被影响，静音段音乐可闻
BGM_GAIN_DB=-20.0
# 指定本地音轨文件（留空 → 用 apps/api/src/onetake_api/assets/bgm/ 内置库；内置库为空则不叠 BGM）
BGM_TRACK_PATH=
# 闪避参数：阈值越低越早开始压、比率越高压得越狠（默认按"人声清晰优先"）
BGM_DUCK_THRESHOLD=0.03
BGM_DUCK_RATIO=12.0

# ---- 免 Key 素材（批次 4a：0 成本路径）----
# 默认关闭 → 不启用时逐段生成路径与改造前完全一致；开启后只有"商品不出镜的空镜"用免 Key 素材
STOCK_ENABLED=false
# 每次检索取几条候选（越大越可能挑到合适的，也越慢）
STOCK_SEARCH_LIMIT=5
# 单个素材的体积上限（MB）：超限直接跳过该素材（避免拖进几十 MB 的文件）
STOCK_MAX_ASSET_MB=40

# ---- 多平台导出（批次 6）----
# 小红书 3:4 的处理策略：blur_pad（默认，模糊背景留白，不丢画面）| center_crop（居中裁切，会切掉上下）
EXPORT_XIAOHONGSHU_STRATEGY=blur_pad

# ---- 逐镜 VLM 评分（批次 5，付费）----
# 默认关闭；打开后每个"已采用分段"会调 1 次 Qwen-VL 评分（走与其它付费入口同一道费用闸）
SEGMENT_QUALITY_ENABLED=false
# Qwen-VL 单价（元/次）：**必须填**，否则预估会如实报"待核算"（不会按 0 算）
QWEN_VL_PRICE_PER_CALL=

# ---- 文案审稿（批次 2b，付费）----
# 默认关闭；打开后每次文案生成会多一次 LLM 调用（4 维度审稿 + 只重写不合格的单句）
SCRIPT_REVIEW_ENABLED=false
